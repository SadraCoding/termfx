#!/usr/bin/env python3
"""Executable entry point for the termfx engine (the package lives next to this file)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from termfx_engine import main

if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)
