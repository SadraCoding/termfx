#!/usr/bin/env bash
# shellcheck disable=SC2034  # settings and colours are consumed by the sourced termfx.d modules
# termfx - control the animated terminal header
set -uo pipefail
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/termfx"
ART_DIR="$CONF_DIR/art"
CONF="$CONF_DIR/config"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/termfx"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/termfx"
THEMES="$(command -v termfx-themes 2>/dev/null || echo "$HOME/.local/bin/termfx-themes")"
ENGINE="$(command -v termfx-engine 2>/dev/null || echo "$HOME/.local/bin/termfx-engine")"

PROFILE_DIR="$CONF_DIR/profiles"

STARSHIP_KEYS="starship_theme starship_newline starship_right_prompt starship_follow_symlinks starship_scan_timeout starship_command_timeout starship_directory_length starship_truncate_to_repo starship_git_branch_length starship_git_remote starship_username_always starship_ssh_only starship_duration_min starship_time_format starship_fill_symbol starship_git_symbol starship_modules starship_git_conflicted starship_git_ahead starship_git_behind starship_git_diverged starship_git_untracked starship_git_stashed starship_git_modified starship_git_staged starship_git_renamed starship_git_deleted"
KNOWN_KEYS="enabled art effect palette speed fps intensity max_height max_width fit crop info info_cmd info_config info_gap info_rows info_colors info_style fetch_preset min_cols min_rows reserve intro stars sparkle glitch sweep vignette frame_ms pause ui prompt icons theme prompt_style prompt_char prompt_lines clock clock_format truecolor align rotate rotate_interval notification notify_after $STARSHIP_KEYS"

if [[ -t 1 ]]; then B=$'\e[1m'; D=$'\e[2m'; G=$'\e[38;5;114m'; R=$'\e[38;5;204m'; Y=$'\e[38;5;221m'; C=$'\e[38;5;117m'; M=$'\e[38;5;183m'; Z=$'\e[0m'
else B=""; D=""; G=""; R=""; Y=""; C=""; M=""; Z=""; fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✔%s %s\n' "$G" "$Z" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$Z" "$*" >&2; }
die()  { printf '%s✘%s %s\n' "$R" "$Z" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

CLI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/termfx.d"
for _tfx_module in "$CLI_DIR"/*.sh; do . "$_tfx_module"; done
unset _tfx_module

COMMANDS="header art effect palette theme prompt starship info fastfetch notify align rotate glitch on off reload preview randomize profile export import undo status get set keys look config doctor restore uninstall version help completion stats"

# Every command is  termfx NAME [VALUE]  (see: termfx help). Older spellings stay as aliases.
case ${1:-help} in
  art)        shift; cmd_art "$@" ;;
  effect)     shift; cmd_effect "$@" ;;
  palette)    shift; cmd_palette "$@" ;;
  theme)      shift; cmd_theme "$@" ;;
  prompt)     shift; cmd_prompt "$@" ;;
  info)       shift; cmd_info "$@" ;;
  starship)   shift; cmd_starship "$@" ;;
  fastfetch)  shift; cmd_fastfetch "${1:-}" ;;
  align)      shift; cmd_align "$@" ;;
  rotate)     shift; cmd_rotate "$@" ;;
  notify)     shift; cmd_notify "$@" ;;
  glitch)     shift; flag glitch glitch "${1:-}" && reload ;;
  header)     shift; case ${1:-} in
                on|true)   change enabled true;  reload ;;
                off|false) change enabled false; say "  ${D}the header stays off in new terminals until: termfx on${Z}"; reload ;;
                "")        show_current enabled header "termfx header on|off" ;;
                *)         die "usage: termfx header on|off" ;;
              esac ;;
  on)         change enabled true;  reload ;;
  off)        change enabled false; say "  ${D}the header stays off in new terminals until: termfx on${Z}"; reload ;;
  reload)     reload ;;
  preview)    shift; cmd_preview "$@" ;;
  randomize)  cmd_randomize ;;
  profile)    shift; cmd_profile "$@" ;;
  export)     shift; cmd_export "$@" ;;
  import)     shift; cmd_import "$@" ;;
  undo)       cmd_undo ;;
  set)        shift; cmd_set "$@" ;;
  get)        shift; cmd_get "$@" ;;
  keys)       tr ' ' '\n' <<<"$KNOWN_KEYS" ;;
  look)       cmd_look ;;
  config)     shift; cmd_config "$@" ;;
  status)     cmd_status ;;
  stats)      cmd_status ;;
  doctor)     "$ENGINE" doctor ;;
  uninstall)  shift; cmd_installer uninstall "$@" ;;
  restore)    shift; cmd_installer restore "$@" ;;
  completion) shift; cmd_completion "$@" ;;
  version|-v|--version) "$ENGINE" version ;;
  help|-h|--help|"") shift; if [[ -n ${1:-} ]]; then usage_topic "$1"; else usage; fi ;;
  # older spellings (still work)
  info-style) shift; cmd_info style "$@" ;;
  info-colors|info-colours) shift; cmd_info_colors "${1:-}" ;;
  info-rows)  shift; cmd_info_rows "$@" ;;
  char)       shift; cmd_char "${1:-}" ;;
  lines)      shift; cmd_lines "${1:-}" ;;
  clock)      shift; cmd_clock "$@" ;;
  *) hint=$(for c in $COMMANDS; do [[ $c == "${1:0:2}"* ]] && printf '%s ' "$c"; done)
     die "unknown command '$1'${hint:+ - did you mean: ${hint% }?}  (termfx help)" ;;
esac
